# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/intellivault"

# Better Auth Configuration
# Generate a secure random string for the secret (use: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-secret-key-here"

# The base URL of your application
# Development: http://localhost:3000
# Production: https://yourdomain.com
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Node Environment
NODE_ENV="development"

# Pinecone Configuration (for Semantic Search)
# Get these from Pinecone Console: https://app.pinecone.io/
# 1. Create an index with integrated embedding enabled
# 2. Choose model: llama-text-embed-v2 or multilingual-e5-large
# 3. Set field_map: {"text": "chunk_text"}
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_HOST="https://your-index-name-abc123.svc.aped-4627-b74a.pinecone.io"
PINECONE_INDEX_NAME="notes"

# LLM Provider Configuration (for AI Summary and Auto-Tagging)
# At least one provider should be configured

# Ollama (local, free) - Default
# Install Ollama: https://ollama.ai/download
# Run: ollama run llama3.2
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Google Gemini (cloud, recommended for production)
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI (cloud, alternative)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Default LLM provider: ollama, gemini, or openai
DEFAULT_LLM_PROVIDER="ollama"

# AI Feature Flags
# Set to "true" to enable automatic processing on note save
AI_AUTO_SUMMARIZE="false"
AI_AUTO_TAG="false"
