// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Enums
enum EmbeddingStatus {
  PENDING // note exists but not embedded yet
  PROCESSING // currently being embedded by a worker
  READY // vectors in Pinecone are up to date
  ERROR // last attempt failed; can be retried
  DELETED // vectors removed from Pinecone
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum NoteStatus {
  DRAFT // AI Dump in progress, not finalized
  FINAL // Saved/published note
  ARCHIVED // Soft-deleted or archived
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id
  name          String
  email         String
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  notes         Note[]
  tags          Tag[]
  attachments   MediaAttachment[]

  @@unique([email])
  @@map("user")
}

model Note {
  id             String  @id @default(cuid())
  title          String
  generatedTitle String?
  summary        String?
  contentJSON    Json
  contentText    String

  // Note lifecycle status
  status NoteStatus @default(FINAL)

  // AI Dump specific fields (nullable for regular notes)
  rawText          String? @db.Text // Original input before AI processing
  source           String? // webclipper, upload, clipboard, paste
  originalFilename String?

  // Generated AI content
  titles  Json? // Array of {variant, text, score}
  tldr    String? @db.Text
  actions Json? // Array of {text, assignee, due_date, confidence}

  // Processing options & provenance
  aiOptions  Json? // template, toggles, tone, temperature
  provenance Json? // llm_model, prompt_template_id, temperature, generatedAt
  versions   Json  @default("[]") // Array of version snapshots

  // Vector sync tracking
  embeddingStatus EmbeddingStatus @default(PENDING)
  embeddingsMeta  Json? // chunks, provider, model (for AI Dump)
  lastEmbeddedAt  DateTime?       @db.Timestamptz(6)
  chunkCount      Int? // how many chunks/vectors this note has in Pinecone

  // AI processing tracking
  aiProcessedAt DateTime? @db.Timestamptz(6)
  contentHash   String? // For change detection

  // User preferences
  isPinned Boolean   @default(false)
  pinnedAt DateTime? @db.Timestamptz(6)

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        Tag[]
  attachments MediaAttachment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@index([userId])
  @@index([embeddingStatus])
  @@index([updatedAt])
  @@index([status])
  @@map("note")
}

model MediaAttachment {
  id       String   @id @default(cuid())
  url      String   @unique
  pathname String // Path in blob storage
  filename String // Original filename
  mimeType String
  fileType FileType
  size     Int // File size in bytes
  metadata Json? // Duration, dimensions, etc.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteId String? // Optional link to note (for cleanup)
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([noteId])
  @@map("media_attachment")
}

model Tag {
  id          String    @id @default(cuid())
  name        String
  slug        String
  color       String?
  description String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Tag?      @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Tag[]     @relation("TagHierarchy")
  isFavorite  Boolean   @default(false)
  isArchived  Boolean   @default(false)
  usageCount  Int       @default(0)
  lastUsed    DateTime  @default(now())
  deletedAt   DateTime?
  notes       Note[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  views       TagView[]
  relatedFrom TagRelation[] @relation("RelatedFrom")
  relatedTo   TagRelation[] @relation("RelatedTo")

  @@unique([userId, name])
  @@unique([userId, slug])
  @@map("tag")
}

model TagView {
  id        String   @id @default(cuid())
  name      String
  filters   Json
  tags      Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tag_view")
}

model TagRelation {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  from      Tag      @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Tag      @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)
  strength  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromId, toId])
  @@map("tag_relation")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}
